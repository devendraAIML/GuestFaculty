<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="500.0" prefWidth="700.0"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ForgotPasswordController">

    <!-- SAME BACKGROUND -->
    <style>
        -fx-background-color: linear-gradient(to bottom right, #0f2027, #203a43, #2c5364),
                             linear-gradient(to top left, rgba(102,126,234,0.4), rgba(118,75,162,0.4));
    </style>

    <children>

        <!-- SAME CARD -->
        <VBox alignment="CENTER"
              maxWidth="420"
              spacing="18"
              style="
              -fx-background-color: linear-gradient(to bottom right, rgba(255,255,255,0.92), rgba(240,245,255,0.88));
              -fx-background-radius: 30;
              -fx-border-radius: 30;
              -fx-border-color: linear-gradient(to right, #667eea, #764ba2);
              -fx-border-width: 1.5;
              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25,0,0,8);
              ">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- TITLE -->
            <Label text="Reset Password"
                   style="-fx-font-weight: bold; -fx-text-fill: #2d3436;">
                <font><Font size="26"/></font>
            </Label>

            <!-- FORM -->
            <VBox spacing="14">

                <!-- EMAIL -->
                <TextField fx:id="gmail123"
                           promptText="Enter Gmail / Registered Number"
                           onAction="#gmail1234"
                           style="-fx-background-color: #f8f9fb;
                                  -fx-background-radius: 12;
                                  -fx-border-radius: 12;
                                  -fx-border-color: #dfe6e9;"/>

                <!-- NEW PASSWORD -->
                <HBox spacing="10">
                    <PasswordField fx:id="newpass123"
                                   promptText="Enter New Password"
                                   onAction="#newpass1234"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #f8f9fb;
                                          -fx-background-radius: 12;
                                          -fx-border-radius: 12;
                                          -fx-border-color: #dfe6e9;"/>

                    <TextField fx:id="newpassVisible"
                               managed="false" visible="false"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #f8f9fb;
                                      -fx-background-radius: 12;
                                      -fx-border-radius: 12;
                                      -fx-border-color: #dfe6e9;"/>

                    <Button text="👁"
                            onAction="#toggleNewPass"
                            style="-fx-background-color: transparent;"/>
                </HBox>

                <!-- CONFIRM PASSWORD -->
                <HBox spacing="10">
                    <PasswordField fx:id="confirm123"
                                   promptText="Confirm Password"
                                   onAction="#confirm1234"
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #f8f9fb;
                                          -fx-background-radius: 12;
                                          -fx-border-radius: 12;
                                          -fx-border-color: #dfe6e9;"/>

                    <TextField fx:id="confirmVisible"
                               managed="false" visible="false"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #f8f9fb;
                                      -fx-background-radius: 12;
                                      -fx-border-radius: 12;
                                      -fx-border-color: #dfe6e9;"/>

                    <Button text="👁"
                            onAction="#toggleConfirmPass"
                            style="-fx-background-color: transparent;"/>
                </HBox>

                <!-- ERROR -->
                <Label fx:id="errorLabel"
                       style="-fx-text-fill: red; -fx-font-size: 12;"/>

            </VBox>

            <!-- BUTTONS -->
            <VBox alignment="CENTER" spacing="12">

                <Button fx:id="submit123"
                        text="Submit"
                        onAction="#submit1234"
                        prefWidth="260"
                        style="-fx-background-color: linear-gradient(to right, #a1c4fd, #c2e9fb);
                               -fx-text-fill: #2c3e50;
                               -fx-font-weight: bold;
                               -fx-background-radius: 30;"/>

                <Button fx:id="back123"
                        text="Back"
                        onAction="#back1234"
                        prefWidth="260"
                        style="-fx-background-color: linear-gradient(to right, #d4a5ff, #b8c6ff);
                               -fx-text-fill: #2c3e50;
                               -fx-font-weight: bold;
                               -fx-background-radius: 30;"/>

            </VBox>

        </VBox>

    </children>
</StackPane>